# Αντέγραψε το αρχείο σε .env και συμπλήρωσε τις τιμές.

PORT=8080
# Ο πρώτος λογαριασμός διαχειριστή. Φτιάχνεται μόνο αν δεν υπάρχει ακόμη κανένας χρήστης.
# Αν τα αφήσεις κενά, τον φτιάχνεις από την οθόνη της εφαρμογής την πρώτη φορά που θα την ανοίξεις.
# Τους υπόλοιπους χρήστες τους προσθέτεις από τις Ρυθμίσεις της εφαρμογής.
ERGO_USER=ergolavos
ERGO_PASSWORD=άλλαξέ-με

# Πακέτο συνδρομής: mastoras, synergeio ή ergotaxio. Κενό = το διαλέγει ο διαχειριστής στις Ρυθμίσεις.
ERGO_PLAN=

# Φωτογραφίες του ημερολογίου έργου: μέγιστος συνολικός χώρος σε GB. Κενό = 20.
PHOTO_MAX_GB=

# Ειδοποιήσεις στο κινητό: διεύθυνση επικοινωνίας για τις υπηρεσίες push (Google, Apple, Mozilla). Κενό = mailto:info@paron.gr
PUSH_SUBJECT=

# dryrun = τα μηνύματα ετοιμάζονται και καταγράφονται αλλά ΔΕΝ στέλνονται
# http   = στέλνονται μέσω του παρόχου Viber Business (π.χ. Apifon, Yuboto, Infobip)
VIBER_PROVIDER=dryrun

# Τα παρακάτω τα δίνει ο πάροχος μόλις εγκρίνει τον λογαριασμό.
# Στο VIBER_BODY τα {{phone}}, {{text}}, {{sender}} αντικαθίστανται αυτόματα.
# Παράδειγμα σε μορφή Infobip (επιβεβαίωσε με την τεκμηρίωση του παρόχου σου):
VIBER_URL=https://XXXX.api.infobip.com/viber/2/messages
VIBER_HEADERS={"Authorization":"App ΤΟ-API-KEY-ΣΟΥ"}
VIBER_BODY={"messages":[{"sender":"{{sender}}","destinations":[{"to":"{{phone}}"}],"content":{"text":"{{text}}","type":"TEXT"}}]}
VIBER_SENDER=ΟνομαΕταιρειας
